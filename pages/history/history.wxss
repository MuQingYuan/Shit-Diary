.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #F2F2F7;
  box-sizing: border-box;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
  color: #1C1C1E;
}

.hv { opacity: 0.6; }

/* 年份筛选条（常驻顶部） */
.filter-bar {
  flex-shrink: 0;
  padding: 20rpx 32rpx 16rpx;
  background: #F2F2F7;
}
.year-scroll { white-space: nowrap; width: 100%; }
.year-chip {
  display: inline-block;
  padding: 12rpx 32rpx;
  margin-right: 16rpx;
  background: #fff;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #1C1C1E;
}
.year-chip.active {
  background: #34C759;
  color: #fff;
  font-weight: 600;
}
.total-tip {
  display: block;
  font-size: 22rpx;
  color: #8E8E93;
  margin: 14rpx 4rpx 0;
}

.loading { text-align: center; color: #8E8E93; padding: 80rpx 0; font-size: 26rpx; }
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #8E8E93;
  padding: 120rpx 0;
  font-size: 26rpx;
}
.empty-icon { font-size: 80rpx; margin-bottom: 20rpx; }

.list-scroll {
  flex: 1;
  padding: 8rpx 32rpx 40rpx;
  box-sizing: border-box;
}
.group { margin-bottom: 28rpx; }
.group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 8rpx 14rpx;
}
.group-date {
  font-size: 26rpx;
  font-weight: 600;
  color: #1C1C1E;
}
.group-count {
  font-size: 22rpx;
  color: #8E8E93;
  background: #E9E9EE;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}
.list-bottom {
  text-align: center;
  color: #C7C7CC;
  font-size: 22rpx;
  padding: 20rpx 0 10rpx;
}
.row {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 14rpx;
}
.row-time { font-size: 28rpx; font-weight: 500; width: 140rpx; }
.row-body { flex: 1; display: flex; gap: 20rpx; }
.row-bristol {
  background: #EAF6EC;
  color: #2E9E4F;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 14rpx;
}
.row-dur { font-size: 24rpx; color: #8E8E93; }
.arrow { color: #C7C7CC; font-size: 32rpx; }

.mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99;
}
.detail-panel {
  width: 600rpx;
  max-height: 82vh;
  overflow-y: auto;
  background: #fff;
  border-radius: 28rpx;
  padding: 32rpx 32rpx 28rpx;
  box-sizing: border-box;
}

/* 顶部 Bristol 头图 */
.detail-hero {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
}
.hero-badge {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  color: #fff;
  font-size: 40rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.hero-info { display: flex; flex-direction: column; min-width: 0; }
.hero-name { font-size: 30rpx; font-weight: 600; color: #1C1C1E; }
.hero-desc { font-size: 22rpx; color: #8E8E93; margin-top: 6rpx; line-height: 1.4; }

.detail-when {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #8E8E93;
  margin: 20rpx 0 24rpx;
}

/* 信息网格 2 列 */
.detail-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 26rpx;
}
.grid-cell {
  width: calc(50% - 8rpx);
  background: #F7F7FA;
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.gc-k { font-size: 22rpx; color: #8E8E93; }
.gc-v { font-size: 28rpx; font-weight: 600; color: #1C1C1E; }

/* 段落 */
.detail-sec { margin-bottom: 22rpx; }
.sec-title {
  display: block;
  font-size: 24rpx;
  color: #8E8E93;
  margin-bottom: 12rpx;
}
.sec-tags { display: flex; flex-wrap: wrap; gap: 12rpx; }
.sec-tag {
  background: #EAF6EC;
  color: #2E9E4F;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 14rpx;
}
.sec-empty { font-size: 24rpx; color: #C7C7CC; }
.sec-note {
  background: #F7F7FA;
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  font-size: 26rpx;
  color: #1C1C1E;
  line-height: 1.6;
  word-break: break-all;
}
.btn-del {
  margin-top: 28rpx;
  background: #FFF1F0;
  color: #E24B4A;
  font-size: 28rpx;
  border-radius: 20rpx;
  border: none;
}
.btn-del::after { border: none; }
.btn-close {
  margin-top: 16rpx;
  background: #F0F0F3;
  color: #555;
  font-size: 28rpx;
  border-radius: 20rpx;
  border: none;
}
.btn-close::after { border: none; }
