.page {
  min-height: 100vh;
  background: #F2F2F7;
  padding: 24rpx 32rpx 40rpx;
  box-sizing: border-box;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
  color: #1C1C1E;
}

.hv { opacity: 0.6; }

.filter { margin-bottom: 20rpx; }
.filter-btn {
  display: inline-flex;
  align-items: center;
  background: #fff;
  padding: 14rpx 28rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  color: #34C759;
  font-weight: 500;
}

.loading { text-align: center; color: #8E8E93; padding: 80rpx 0; font-size: 26rpx; }
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #8E8E93;
  padding: 120rpx 0;
  font-size: 26rpx;
}
.empty-icon { font-size: 80rpx; margin-bottom: 20rpx; }

.group { margin-bottom: 32rpx; }
.group-date {
  display: block;
  font-size: 24rpx;
  color: #8E8E93;
  margin: 0 8rpx 14rpx;
}
.row {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 14rpx;
}
.row-time { font-size: 28rpx; font-weight: 500; width: 140rpx; }
.row-body { flex: 1; display: flex; gap: 20rpx; }
.row-bristol {
  background: #EAF6EC;
  color: #2E9E4F;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 14rpx;
}
.row-dur { font-size: 24rpx; color: #8E8E93; }
.arrow { color: #C7C7CC; font-size: 32rpx; }

.mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99;
}
.detail-panel {
  width: 580rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 36rpx 32rpx 28rpx;
}
.detail-title { font-size: 34rpx; font-weight: 600; text-align: center; margin-bottom: 24rpx; }
.detail-row { display: flex; padding: 14rpx 0; border-bottom: 0.5px solid rgba(60, 60, 67, 0.06); }
.k { width: 140rpx; font-size: 26rpx; color: #8E8E93; }
.v { flex: 1; font-size: 26rpx; }
.btn-del {
  margin-top: 28rpx;
  background: #FFF1F0;
  color: #E24B4A;
  font-size: 28rpx;
  border-radius: 20rpx;
  border: none;
}
.btn-del::after { border: none; }
.btn-close {
  margin-top: 16rpx;
  background: #F0F0F3;
  color: #555;
  font-size: 28rpx;
  border-radius: 20rpx;
  border: none;
}
.btn-close::after { border: none; }
