<view class="page">
  <view class="filter">
    <picker mode="selector" range="{{months}}" value="{{monthIndex}}" bindchange="onMonthChange">
      <view class="filter-btn" hover-class="hv">{{months[monthIndex] || '全部'}} 月份 ▾</view>
    </picker>
  </view>

  <view wx:if="{{loading}}" class="loading">加载中…</view>

  <view wx:elif="{{!list.length}}" class="empty">
    <text class="empty-icon">📖</text>
    <text>还没有记录，快去打卡吧</text>
  </view>

  <view wx:else>
    <view class="group" wx:for="{{list}}" wx:key="date" wx:for-index="gi">
      <text class="group-date">{{item.label}}</text>
      <view class="row" wx:for="{{item.items}}" wx:for-item="rec" wx:for-index="ii" wx:key="_id"
            hover-class="hv" data-gi="{{gi}}" data-ii="{{ii}}" bindtap="openDetail">
        <text class="row-time">{{rec.time || ''}}</text>
        <view class="row-body">
          <text class="row-bristol">{{rec.bristolType ? rec.bristolType + ' 型' : ''}}</text>
          <text class="row-dur">{{rec.durText}}</text>
        </view>
        <text class="arrow">›</text>
      </view>
    </view>
  </view>

  <view class="mask" wx:if="{{detail}}" bindtap="closeDetail">
    <view class="detail-panel" catchtap="noop">
      <text class="detail-title">记录详情</text>
      <view class="detail-row"><text class="k">时间</text><text class="v">{{detail.time}}</text></view>
      <view class="detail-row"><text class="k">Bristol</text><text class="v">{{detail.bristol}}</text></view>
      <view class="detail-row"><text class="k">时长</text><text class="v">{{detail.dur}}</text></view>
      <view class="detail-row"><text class="k">症状</text><text class="v">{{detail.symptoms}}</text></view>
      <view class="detail-row"><text class="k">备注</text><text class="v">{{detail.note}}</text></view>
      <button class="btn-del" hover-class="hv" bindtap="onDelete">删除这条记录</button>
      <button class="btn-close" hover-class="hv" bindtap="closeDetail">关闭</button>
    </view>
  </view>
</view>
