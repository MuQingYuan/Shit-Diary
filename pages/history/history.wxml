<view class="page">
  <!-- 年份筛选条（常驻顶部，可横向滚动） -->
  <view class="filter-bar">
    <scroll-view scroll-x class="year-scroll" enable-flex>
      <view class="year-chip {{yearIndex === idx ? 'active' : ''}}"
            wx:for="{{years}}" wx:key="*this" wx:for-index="idx"
            hover-class="hv" data-idx="{{idx}}" bindtap="onYearChange">{{item}}</view>
    </scroll-view>
    <text class="total-tip">共 {{total}} 条记录</text>
  </view>

  <view wx:if="{{loading}}" class="loading">加载中…</view>

  <view wx:elif="{{!list.length}}" class="empty">
    <text class="empty-icon">📖</text>
    <text>还没有记录，快去打卡吧</text>
  </view>

  <scroll-view wx:else scroll-y class="list-scroll">
    <view class="group {{item.collapsed ? 'collapsed' : ''}}" wx:for="{{list}}" wx:key="key" wx:for-index="gi">
      <view class="group-head" hover-class="hv" data-gi="{{gi}}" bindtap="toggleGroup">
        <text class="group-date">{{item.label}}</text>
        <view class="group-right">
          <text class="group-count">{{item.items.length}} 次</text>
          <view class="group-toggle {{item.collapsed ? 'collapsed' : ''}}"></view>
        </view>
      </view>
      <block wx:if="{{!item.collapsed}}">
        <view class="row" wx:for="{{item.items}}" wx:for-item="rec" wx:for-index="ii" wx:key="_id"
              hover-class="hv" data-gi="{{gi}}" data-ii="{{ii}}" bindtap="openDetail">
          <text class="row-time">{{rec.time || ''}}</text>
          <view class="row-body">
            <text class="row-bristol">{{rec.bristolType ? rec.bristolType + ' 型' : ''}}</text>
            <text class="row-dur">{{rec.durText}}</text>
          </view>
          <text class="arrow">›</text>
        </view>
      </block>
    </view>
    <view class="list-bottom">没有更多了</view>
  </scroll-view>

  <view class="mask" wx:if="{{detail}}" bindtap="closeDetail">
    <view class="detail-panel" catchtap="noop">
      <view class="detail-hero" style="background: {{detail.bristolColor}}14;">
        <view class="hero-badge" style="background: {{detail.bristolColor}};">{{detail.bristolType}}</view>
        <view class="hero-info">
          <text class="hero-name">{{detail.bristolName}}</text>
          <text class="hero-desc">{{detail.bristolDesc}}</text>
        </view>
      </view>
      <text class="detail-when">{{detail.date}} {{detail.time}}</text>

      <view class="detail-grid">
        <view class="grid-cell"><text class="gc-k">时长</text><text class="gc-v">{{detail.dur}}</text></view>
        <view class="grid-cell"><text class="gc-k">量</text><text class="gc-v">{{detail.amount}}</text></view>
        <view class="grid-cell"><text class="gc-k">颜色</text><text class="gc-v">{{detail.color}}</text></view>
        <view class="grid-cell"><text class="gc-k">心情</text><text class="gc-v">{{detail.mood}}</text></view>
      </view>

      <view class="detail-sec">
        <text class="sec-title">症状</text>
        <view class="sec-tags">
          <text wx:if="{{detail.symptomTags.length === 0}}" class="sec-empty">无</text>
          <text wx:for="{{detail.symptomTags}}" wx:key="*this" class="sec-tag">{{item}}</text>
        </view>
      </view>

      <view class="detail-sec">
        <text class="sec-title">备注</text>
        <view class="sec-note"><text wx:if="{{!detail.note}}" class="sec-empty">无备注</text><text wx:else>{{detail.note}}</text></view>
      </view>

      <button class="btn-del" hover-class="hv" bindtap="onDelete">删除这条记录</button>
      <button class="btn-close" hover-class="hv" bindtap="closeDetail">关闭</button>
    </view>
  </view>
</view>
