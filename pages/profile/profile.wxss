.page {
  min-height: 100vh;
  background: #F2F2F7;
  padding: 24rpx 32rpx 40rpx;
  box-sizing: border-box;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
  color: #1C1C1E;
}

.hv { opacity: 0.6; }

.card {
  background: #fff;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.profile { display: flex; flex-direction: column; align-items: center; }
.avatar-btn {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  padding: 0;
  margin: 8rpx 0 24rpx;
  background: #EAF6EC;
  color: #2E9E4F;
  font-size: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  border: none;
}
.avatar-btn::after { border: none; }
.avatar-img { width: 100%; height: 100%; }
.avatar-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.35);
  color: #fff;
  font-size: 18rpx;
  text-align: center;
  padding: 4rpx 0;
}
.nick-input {
  width: 100%;
  text-align: center;
  font-size: 36rpx;
  font-weight: 600;
  padding: 8rpx 0;
}
.btn-save {
  margin-top: 28rpx;
  width: 100%;
  background: #34C759;
  color: #fff;
  font-size: 30rpx;
  border-radius: 26rpx;
  border: none;
  line-height: 2.6;
}
.btn-save::after { border: none; }

.stat-row { display: flex; background: #fff; border-radius: 28rpx; padding: 28rpx 0; margin-bottom: 24rpx; }
.stat { flex: 1; display: flex; flex-direction: column; align-items: center; }
.num { font-size: 44rpx; font-weight: 600; color: #34C759; }
.lbl { font-size: 22rpx; color: #8E8E93; margin-top: 6rpx; }

.menu { padding: 8rpx 28rpx; }
.cell {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  padding: 28rpx 0;
  font-size: 30rpx;
  background: transparent;
  border: none;
  border-radius: 0;
  text-align: left;
  line-height: 1.4;
  color: #1C1C1E;
  border-bottom: 0.5px solid rgba(60, 60, 67, 0.08);
}
.cell:last-child { border-bottom: none; }
.cell::after { border: none; }
.share-cell { display: flex; justify-content: space-between; }
.arrow { color: #C7C7CC; font-size: 36rpx; }

.mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99;
}
.about-panel {
  width: 560rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 40rpx 32rpx 28rpx;
  display: flex;
  flex-direction: column;
}
.about-title { font-size: 34rpx; font-weight: 600; text-align: center; }
.about-body {
  font-size: 26rpx;
  color: #555;
  line-height: 1.7;
  margin: 24rpx 0;
}
.about-close {
  background: #EAF6EC;
  color: #2E9E4F;
  font-size: 28rpx;
  border-radius: 20rpx;
  border: none;
}
.about-close::after { border: none; }
