<view class="container">
  <view class="title">记录一次嗯嗯</view>

  <view class="field">
    <text class="label">Bristol 类型</text>
    <view class="bristol-grid">
      <view wx:for="{{bristolList}}" wx:key="type"
            class="bristol-item {{form.bristolType===item.type?'active':''}}"
            bindtap="onPickBristol" data-type="{{item.type}}">
        <text class="b-type">{{item.type}}</text>
        <text class="b-desc">{{item.desc}}</text>
      </view>
    </view>
  </view>

  <view class="field">
    <text class="label">时长</text>
    <view class="dur-summary">
      <text class="dur-ico">⏱</text>
      <text class="dur-value">{{durLabel}}</text>
      <text class="dur-max">最长 1 小时 30 分钟</text>
    </view>
    <view class="dur-chips">
      <view wx:for="{{durationPresets}}" wx:key="sec"
            class="dur-chip {{form.durationSec===item.sec?'active':''}}"
            bindtap="onPickDuration" data-sec="{{item.sec}}">{{item.label}}</view>
    </view>
    <view class="dur-custom">
      <text class="dur-custom-label">自定义（每分钟 ±1）</text>
      <view class="stepper">
        <view class="step-btn" bindtap="onStepDuration" data-d="-1">−</view>
        <text class="step-val">{{durLabel}}</text>
        <view class="step-btn" bindtap="onStepDuration" data-d="1">＋</view>
      </view>
    </view>
  </view>

  <view class="field">
    <text class="label">时间</text>
    <view class="picker-row">
      <picker mode="date" value="{{form.date}}" bindchange="onDateChange">
        <view class="picker-box">{{form.date}}</view>
      </picker>
      <picker mode="time" value="{{form.time}}" bindchange="onTimeChange">
        <view class="picker-box">{{form.time}}</view>
      </picker>
    </view>
  </view>

  <view class="field">
    <text class="label">量</text>
    <view class="tags">
      <view wx:for="{{amountOptions}}" wx:key="*this"
            class="tag {{form.amount===item?'active':''}}"
            bindtap="onPickAmount" data-v="{{item}}">{{item}}</view>
    </view>
  </view>

  <view class="field">
    <text class="label">颜色</text>
    <view class="tags">
      <view wx:for="{{colorOptions}}" wx:key="*this"
            class="tag {{form.color===item?'active':''}}"
            bindtap="onPickColor" data-v="{{item}}">{{item}}</view>
    </view>
  </view>

  <view class="field">
    <text class="label">症状（可多选）</text>
    <view class="tags">
      <view wx:for="{{symptomOptions}}" wx:key="*this"
            class="tag {{form.symptomTags.indexOf(item)>-1?'active':''}}"
            bindtap="onToggleSymptom" data-v="{{item}}">{{item}}</view>
    </view>
  </view>

  <view class="field">
    <text class="label">心情</text>
    <view class="tags">
      <view wx:for="{{moodOptions}}" wx:key="*this"
            class="tag {{form.mood===item?'active':''}}"
            bindtap="onPickMood" data-v="{{item}}">{{item}}</view>
    </view>
  </view>

  <view class="field">
    <view class="note-head {{noteExpanded?'open':''}}" bindtap="toggleNote">
      <text class="note-ico">📝</text>
      <text class="note-title">备注</text>
      <text class="note-action">{{noteExpanded ? '收起' : (form.note ? '编辑' : '添加')}}</text>
    </view>
    <block wx:if="{{noteExpanded}}">
      <textarea class="note-area" value="{{form.note}}" bindinput="onNote" maxlength="200"
                placeholder="今天感觉如何？有什么想记录的～"/>
      <view class="note-foot"><text class="note-count">{{noteLen}}/200</text></view>
    </block>
    <view wx:elif="{{form.note}}" class="note-preview" bindtap="toggleNote">{{form.note}}</view>
  </view>

  <button class="submit btn-primary" bindtap="onSubmit">保存记录</button>
</view>
