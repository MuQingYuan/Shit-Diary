.container { padding: 32rpx; }
.title { font-size: 40rpx; font-weight: 600; margin-bottom: 24rpx; }
.field { margin-bottom: 36rpx; }
.label { display: block; font-size: 28rpx; color: #555; margin-bottom: 16rpx; }
.bristol-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.bristol-item {
  width: 140rpx; padding: 16rpx 0; border-radius: 16rpx;
  background: #fff; border: 2rpx solid #eee; text-align: center;
}
.bristol-item.active { border-color: #5B8C5A; background: #eef5ee; }
.b-type { display: block; font-size: 32rpx; font-weight: 600; color: #5B8C5A; }
.b-desc { display: block; font-size: 22rpx; color: #888; }
.tags { display: flex; flex-wrap: wrap; gap: 16rpx; }
.tag { padding: 12rpx 28rpx; border-radius: 32rpx; background: #fff; border: 2rpx solid #eee; font-size: 26rpx; }
.tag.active { background: #5B8C5A; color: #fff; border-color: #5B8C5A; }
.submit { margin-top: 16rpx; }
textarea { width: 100%; height: 160rpx; background: #fff; border-radius: 16rpx; padding: 20rpx; box-sizing: border-box; font-size: 28rpx; }
