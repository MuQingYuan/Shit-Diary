.container { padding: 32rpx; }
.title { font-size: 40rpx; font-weight: 600; margin-bottom: 24rpx; }
.field { margin-bottom: 36rpx; }
.label { display: block; font-size: 28rpx; color: #555; margin-bottom: 16rpx; }

.bristol-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.bristol-item {
  width: 140rpx; padding: 16rpx 0; border-radius: 16rpx;
  background: #fff; border: 2rpx solid #eee; text-align: center;
}
.bristol-item.active { border-color: #34C759; background: #EAF6EC; }
.b-type { display: block; font-size: 32rpx; font-weight: 600; color: #34C759; }
.b-desc { display: block; font-size: 22rpx; color: #888; }

.tags { display: flex; flex-wrap: wrap; gap: 16rpx; }
.tag { padding: 12rpx 28rpx; border-radius: 32rpx; background: #fff; border: 2rpx solid #eee; font-size: 26rpx; }
.tag.active { background: #34C759; color: #fff; border-color: #34C759; }

/* 时长：摘要 + 预设胶囊 */
.dur-summary { display: flex; align-items: baseline; gap: 12rpx; margin-bottom: 18rpx; }
.dur-ico { font-size: 30rpx; }
.dur-value { font-size: 36rpx; font-weight: 700; color: #1C1C1E; }
.dur-max { font-size: 22rpx; color: #8E8E93; margin-left: auto; }
.dur-chips { display: flex; flex-wrap: wrap; gap: 16rpx; }
.dur-chip {
  padding: 14rpx 26rpx; border-radius: 32rpx; background: #fff;
  border: 2rpx solid #eee; font-size: 26rpx; color: #333;
}
.dur-chip.active { background: #34C759; color: #fff; border-color: #34C759; font-weight: 600; }

/* 备注：可展开的录入入口 */
.note-head {
  display: flex; align-items: center; gap: 12rpx;
  padding: 20rpx 24rpx; border-radius: 16rpx;
  background: #fff; border: 2rpx solid #eee;
}
.note-head.open { border-color: #34C759; }
.note-ico { font-size: 30rpx; }
.note-title { font-size: 28rpx; font-weight: 600; color: #1C1C1E; }
.note-action { margin-left: auto; font-size: 26rpx; color: #34C759; }
.note-area {
  width: 100%; height: 180rpx; background: #fff; border-radius: 16rpx;
  padding: 20rpx; box-sizing: border-box; font-size: 28rpx; margin-top: 16rpx;
  border: 2rpx solid #eee;
}
.note-foot { display: flex; justify-content: flex-end; margin-top: 8rpx; }
.note-count { font-size: 22rpx; color: #8E8E93; }
.note-preview {
  margin-top: 12rpx; font-size: 26rpx; color: #555; line-height: 1.5;
  background: #F7F7FA; border-radius: 12rpx; padding: 16rpx 20rpx;
}

.submit { margin-top: 16rpx; }
