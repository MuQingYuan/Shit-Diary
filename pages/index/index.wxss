.page {
  min-height: 100vh;
  background: #F2F2F7;
  padding: 16rpx 32rpx 40rpx;
  box-sizing: border-box;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  color: #1C1C1E;
}

.hv { opacity: 0.6; }

/* 头部 */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 16rpx 8rpx 28rpx;
}
.header-left { flex: 1; }
.title {
  font-size: 52rpx;
  font-weight: 600;
  letter-spacing: -1rpx;
  line-height: 1.1;
}
.date {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8E8E93;
  font-weight: 400;
}
.header-right { display: flex; align-items: center; gap: 20rpx; }
.share-btn {
  width: 64rpx;
  height: 64rpx;
  padding: 0;
  border-radius: 50%;
  background: #fff;
  color: #34C759;
  font-size: 30rpx;
  line-height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  margin: 0;
}
.share-btn::after { border: none; }
.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #34C759;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
  overflow: hidden;
}
.avatar-img { width: 100%; height: 100%; }

/* 错误条 */
.error-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #FFEBE9;
  border-radius: 24rpx;
  padding: 20rpx 28rpx;
  margin-bottom: 24rpx;
  font-size: 24rpx;
  color: #C0392B;
}
.error-retry { color: #34C759; font-weight: 500; margin-left: 20rpx; }

/* 骨架屏 */
.skeleton { padding-top: 4rpx; }
.sk-card {
  height: 320rpx;
  background: #E9E9EE;
  border-radius: 36rpx;
  margin-bottom: 24rpx;
  animation: sk 1.2s ease-in-out infinite alternate;
}
.sk-row { display: flex; gap: 24rpx; margin-bottom: 24rpx; }
.sk-half { flex: 1; height: 170rpx; background: #E9E9EE; border-radius: 36rpx; animation: sk 1.2s ease-in-out infinite alternate; }
@keyframes sk {
  from { opacity: 1; }
  to { opacity: 0.5; }
}

.card {
  background: #fff;
  border-radius: 36rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

/* Hero */
.hero { display: flex; flex-direction: column; align-items: center; }
.hero-icon {
  width: 136rpx;
  height: 136rpx;
  border-radius: 50%;
  background: #EAF6EC;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 68rpx;
  transition: all 0.3s;
}
.hero-icon.done { background: #34C759; font-size: 56rpx; color: #fff; }
.hero-title { margin-top: 24rpx; font-size: 34rpx; font-weight: 600; }
.hero-sub { margin-top: 8rpx; font-size: 24rpx; color: #8E8E93; }
.btn-record {
  margin-top: 32rpx;
  width: 100%;
  background: #34C759;
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 26rpx;
  border: none;
  line-height: 2.6;
}
.btn-record::after { border: none; }
.btn-record.disabled { opacity: 0.6; }
.btn-hv { opacity: 0.85; transform: scale(0.985); }
.hero-link { margin-top: 24rpx; font-size: 24rpx; color: #34C759; }

/* 统计卡 */
.stat-row { display: flex; gap: 24rpx; }
.stat { flex: 1; position: relative; }
.stat-label { display: block; font-size: 24rpx; color: #8E8E93; }
.stat-num { display: block; margin-top: 8rpx; font-size: 44rpx; font-weight: 600; line-height: 1.2; }
.stat-unit { font-size: 24rpx; color: #8E8E93; font-weight: 400; }
.stat-arrow {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 36rpx;
  color: #C7C7CC;
}

/* 趋势 */
.trend-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}
.card-title { font-size: 30rpx; font-weight: 600; }
.trend-tag { font-size: 22rpx; color: #8E8E93; }
.bars {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 8rpx;
}
.bar-item { display: flex; flex-direction: column; align-items: center; gap: 10rpx; }
.bar-count { font-size: 20rpx; color: #34C759; font-weight: 500; }
.bar {
  width: 44rpx;
  border-radius: 10rpx;
  background: #C8E6CB;
}
.bar.hot { background: #34C759; }
.bar-day { font-size: 20rpx; color: #8E8E93; }
.empty {
  text-align: center;
  font-size: 24rpx;
  color: #8E8E93;
  padding: 40rpx 0;
}

/* 提醒 */
.remind { display: flex; justify-content: space-between; align-items: center; }
.remind-main { flex: 1; }
.remind-sub { margin-top: 6rpx; font-size: 24rpx; color: #8E8E93; }
.remind-switch { flex-shrink: 0; margin-left: 20rpx; }

/* 周报入口 */
.about-sub { display: block; margin-top: 8rpx; font-size: 24rpx; color: #8E8E93; }
.about-link { display: block; margin-top: 16rpx; font-size: 26rpx; color: #34C759; font-weight: 500; }

.safe-bottom { height: env(safe-area-inset-bottom); }

/* ===== 半屏快捷记录面板 ===== */
.quick-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
  animation: qmFade 0.2s ease;
}
@keyframes qmFade {
  from { opacity: 0; }
  to { opacity: 1; }
}
.quick-panel {
  width: 100%;
  background: #fff;
  border-radius: 36rpx 36rpx 0 0;
  padding: 16rpx 40rpx calc(36rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  animation: qpUp 0.28s ease;
}
@keyframes qpUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
.qp-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #D1D1D6;
  margin: 0 auto 24rpx;
}
.qp-title { font-size: 34rpx; font-weight: 600; text-align: center; }
.qp-label { font-size: 26rpx; font-weight: 500; margin: 28rpx 0 16rpx; }
.qp-dur { color: #34C759; font-weight: 600; margin-left: 8rpx; }
.qp-bristol { display: flex; justify-content: space-between; }
.bristol-mini {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: #fff;
  border: 2rpx solid #E5E5EA;
  color: #34C759;
  font-size: 34rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.15s;
}
.bristol-mini.active { border-color: #34C759; background: #EAF6EC; }
.qp-slider { margin: 0 8rpx; }
.qp-presets { display: flex; gap: 20rpx; }
.preset {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 20rpx;
  background: #F0F0F3;
  color: #555;
  font-size: 26rpx;
  transition: all 0.15s;
}
.preset.on { background: #EAF6EC; color: #2E9E4F; font-weight: 600; }
.qp-actions { display: flex; gap: 24rpx; margin-top: 40rpx; }
.qp-btn { flex: 1; font-size: 30rpx; border-radius: 26rpx; line-height: 2.6; border: none; }
.qp-btn::after { border: none; }
.qp-cancel { background: #F0F0F3; color: #555; }
.qp-confirm { background: #34C759; color: #fff; font-weight: 500; }
.qp-confirm.disabled { opacity: 0.6; }
