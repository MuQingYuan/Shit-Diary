.page {
  min-height: 100vh;
  background: #F2F2F7;
  padding: 16rpx 32rpx 60rpx;
  box-sizing: border-box;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  color: #1C1C1E;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 16rpx 8rpx 28rpx;
}
.title {
  font-size: 52rpx;
  font-weight: 600;
  letter-spacing: -1rpx;
  line-height: 1.1;
}
.date {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8E8E93;
  font-weight: 400;
}
.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #34C759;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
}

.card {
  background: #fff;
  border-radius: 36rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.hero-icon {
  width: 136rpx;
  height: 136rpx;
  border-radius: 50%;
  background: #EAF6EC;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
}
.hero-title {
  margin-top: 24rpx;
  font-size: 34rpx;
  font-weight: 600;
}
.hero-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8E8E93;
}
.btn-record {
  margin-top: 32rpx;
  width: 100%;
  background: #34C759;
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 26rpx;
  border: none;
  line-height: 2.6;
}
.btn-record::after { border: none; }

.stats-row {
  display: flex;
  gap: 24rpx;
}
.stat {
  flex: 1;
}
.stat-label {
  display: block;
  font-size: 24rpx;
  color: #8E8E93;
}
.stat-num {
  display: block;
  margin-top: 8rpx;
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.2;
}
.stat-unit {
  font-size: 24rpx;
  color: #8E8E93;
  font-weight: 400;
}

.trend-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}
.card-title {
  font-size: 30rpx;
  font-weight: 600;
}
.trend-tag {
  font-size: 22rpx;
  color: #8E8E93;
}
.bars {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 8rpx;
}
.bar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}
.bar {
  width: 44rpx;
  border-radius: 10rpx;
  background: #C8E6CB;
}
.bar.hot { background: #34C759; }
.bar-day {
  font-size: 20rpx;
  color: #8E8E93;
}

.remind {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.remind-left {
  display: flex;
  flex-direction: column;
}
.remind-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #8E8E93;
}

.about-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8E8E93;
}
.about-link {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #34C759;
  font-weight: 500;
}
