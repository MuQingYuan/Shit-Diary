.page {
  min-height: 100vh;
  background: #F2F2F7;
  padding: 16rpx 32rpx 40rpx;
  box-sizing: border-box;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  color: #1C1C1E;
}
.hv { opacity: 0.6; }

.error-bar {
  display: flex; justify-content: space-between; align-items: center;
  background: #FFEBE9; border-radius: 24rpx; padding: 20rpx 28rpx; margin-bottom: 24rpx;
  font-size: 24rpx; color: #C0392B;
}
.error-retry { color: #34C759; font-weight: 500; margin-left: 20rpx; }
.loading { text-align: center; color: #8E8E93; font-size: 26rpx; padding: 120rpx 0; }

.card {
  background: #fff; border-radius: 36rpx; padding: 32rpx;
  margin-bottom: 24rpx;
}
.card-title { font-size: 30rpx; font-weight: 600; margin-bottom: 20rpx; }
.empty { text-align: center; font-size: 24rpx; color: #8E8E93; padding: 28rpx 0; }
.empty.small { padding: 16rpx 0; }

/* 评分头卡 */
.hero {
  display: flex; flex-direction: column; align-items: center;
  background: linear-gradient(160deg, #34C759 0%, #2BA84B 100%);
  color: #fff;
}
.hero-range { font-size: 24rpx; opacity: 0.9; }
.hero-grade { font-size: 72rpx; margin: 16rpx 0 4rpx; }
.hero-score { font-size: 80rpx; font-weight: 700; line-height: 1; }
.hero-score-unit { font-size: 32rpx; font-weight: 400; }
.hero-title { font-size: 34rpx; font-weight: 600; margin-top: 10rpx; }
.hero-comment {
  margin-top: 18rpx; font-size: 24rpx; line-height: 1.6; text-align: center;
  background: rgba(255,255,255,0.18); padding: 16rpx 20rpx; border-radius: 18rpx;
}

/* 关键指标 */
.metrics { display: flex; gap: 20rpx; margin-bottom: 24rpx; }
.metric {
  flex: 1; background: #fff; border-radius: 28rpx; padding: 24rpx 0;
  display: flex; flex-direction: column; align-items: center;
}
.metric-num { font-size: 38rpx; font-weight: 700; }
.metric-unit { font-size: 22rpx; color: #8E8E93; font-weight: 400; }
.metric-label { margin-top: 6rpx; font-size: 22rpx; color: #8E8E93; }

/* 便型分布 */
.dist-row { display: flex; align-items: center; margin-bottom: 18rpx; }
.dist-row:last-child { margin-bottom: 0; }
.dot { width: 20rpx; height: 20rpx; border-radius: 50%; flex-shrink: 0; margin-right: 16rpx; }
.dist-name { width: 180rpx; font-size: 24rpx; color: #1C1C1E; flex-shrink: 0; }
.dist-bar { flex: 1; height: 16rpx; background: #F0F0F3; border-radius: 8rpx; overflow: hidden; }
.dist-fill { height: 100%; border-radius: 8rpx; }
.dist-pct { width: 72rpx; text-align: right; font-size: 22rpx; color: #8E8E93; flex-shrink: 0; }

/* 症状 & 心情 两栏 */
.cols { display: flex; gap: 24rpx; }
.col { flex: 1; }
.tag-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14rpx; }
.tag-row:last-child { margin-bottom: 0; }
.tag {
  font-size: 24rpx; color: #1C1C1E; background: #F0F0F3;
  padding: 6rpx 18rpx; border-radius: 999rpx;
}
.tag-count { font-size: 22rpx; color: #8E8E93; }

/* 一周打卡 */
.week { display: flex; justify-content: space-between; }
.wday {
  width: 72rpx; height: 96rpx; border-radius: 20rpx; background: #F2F2F7;
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6rpx;
}
.wday.on { background: #EAF6EC; }
.wemoji { font-size: 30rpx; line-height: 1; }
.wlabel { font-size: 20rpx; color: #C7C7CC; }
.wday.on .wlabel { color: #34C759; }

/* 贴士 */
.tip { display: flex; align-items: flex-start; margin-bottom: 16rpx; }
.tip:last-child { margin-bottom: 0; }
.tip-dot { color: #34C759; font-weight: 700; margin-right: 12rpx; line-height: 1.6; }
.tip-text { flex: 1; font-size: 24rpx; color: #1C1C1E; line-height: 1.6; }

/* 分享卡 */
.share-canvas {
  width: 100%; height: 1800rpx; border-radius: 24rpx; background: #fff;
  box-shadow: 0 8rpx 30rpx rgba(0,0,0,0.06);
}
.btn-save {
  margin-top: 24rpx; width: 100%; background: #34C759; color: #fff;
  font-size: 30rpx; font-weight: 500; border-radius: 26rpx; border: none; line-height: 2.6;
}
.btn-save::after { border: none; }
.btn-hv { opacity: 0.85; }

.safe-bottom { height: env(safe-area-inset-bottom); }
