.page {
  min-height: 100vh;
  background: #F2F2F7;
  padding: 20rpx 28rpx 40rpx;
  box-sizing: border-box;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  color: #1C1C1E;
}
.hv { opacity: 0.6; }

.loading { text-align: center; color: #8E8E93; font-size: 26rpx; padding: 120rpx 0; }

.error-bar {
  display: flex; justify-content: space-between; align-items: center;
  background: #FFEBE9; border-radius: 24rpx; padding: 20rpx 28rpx; margin-bottom: 24rpx;
  font-size: 24rpx; color: #C0392B;
}
.error-retry { color: #34C759; font-weight: 500; margin-left: 20rpx; }

.card {
  background: #fff; border-radius: 28rpx; padding: 30rpx;
  margin-bottom: 20rpx;
}
.card-title { font-size: 30rpx; font-weight: 600; margin-bottom: 28rpx; color: #1C1C1E; display: flex; align-items: center; }
.sec-ico { display: inline-flex; align-items: center; justify-content: center; width: 44rpx; height: 44rpx; border-radius: 14rpx; background: #F0F0F3; margin-right: 14rpx; font-size: 24rpx; flex-shrink: 0; }
.empty { text-align: center; font-size: 24rpx; color: #8E8E93; padding: 28rpx 0; }
.empty.small { padding: 16rpx 0; }

/* 评分头卡 */
.hero {
  display: flex; flex-direction: column; align-items: center;
  background: linear-gradient(160deg, #34C759 0%, #2BA84B 100%);
  color: #fff;
  padding: 36rpx 32rpx 40rpx;
}
.hero-range { font-size: 24rpx; opacity: 0.92; letter-spacing: 0.5px; }
.hero-grade { font-size: 64rpx; margin: 18rpx 0 16rpx; line-height: 1; }
.ring {
  width: 176rpx; height: 176rpx; border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  display: flex; align-items: center; justify-content: center;
}
.ring-in {
  width: 146rpx; height: 146rpx; border-radius: 50%;
  background: linear-gradient(160deg, #34C759 0%, #2BA84B 100%);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  color: #fff;
  box-shadow: inset 0 0 0 4rpx rgba(255, 255, 255, 0.25);
}
.hero-score { font-size: 64rpx; font-weight: 700; line-height: 1; }
.hero-score-unit { font-size: 26rpx; font-weight: 400; }
.hero-score-cap { font-size: 22rpx; opacity: 0.9; margin-top: 4rpx; }
.hero-title { font-size: 34rpx; font-weight: 600; margin-top: 22rpx; }
.hero-comment {
  margin-top: 16rpx; font-size: 24rpx; line-height: 1.6; text-align: center;
  background: rgba(255, 255, 255, 0.18); padding: 16rpx 22rpx; border-radius: 18rpx;
  max-width: 100%;
}

/* 关键指标（统一卡片 + 分隔线） */
.metrics-card { padding: 6rpx 0; }
.metrics { display: flex; }
.metric {
  flex: 1; position: relative;
  display: flex; flex-direction: column; align-items: center;
  padding: 26rpx 0;
}
.metric:not(:last-child)::after {
  content: ''; position: absolute; right: 0; top: 26rpx; bottom: 26rpx;
  width: 1rpx; background: #ECECEF;
}
.metric-num { font-size: 38rpx; font-weight: 700; }
.metric-unit { font-size: 22rpx; color: #8E8E93; font-weight: 400; }
.metric-label { margin-top: 8rpx; font-size: 22rpx; color: #8E8E93; }

/* 便型分布 */
.dist-row { display: flex; align-items: center; margin-bottom: 20rpx; }
.dist-row:last-child { margin-bottom: 0; }
.dot { width: 20rpx; height: 20rpx; border-radius: 50%; flex-shrink: 0; margin-right: 16rpx; }
.dist-name { width: 168rpx; font-size: 24rpx; color: #1C1C1E; flex-shrink: 0; }
.dist-bar { flex: 1; height: 16rpx; background: #F0F0F3; border-radius: 8rpx; overflow: hidden; }
.dist-fill { height: 100%; border-radius: 8rpx; }
.dist-pct { width: 72rpx; text-align: right; font-size: 22rpx; color: #8E8E93; flex-shrink: 0; margin-left: 12rpx; }

/* 症状 & 心情 两栏 */
.cols { display: flex; gap: 20rpx; }
.col { flex: 1; }
.tag-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; gap: 10rpx; }
.tag-row:last-child { margin-bottom: 0; }
.tag {
  font-size: 24rpx; color: #1C1C1E; background: #F0F0F3;
  padding: 8rpx 18rpx; border-radius: 999rpx; flex-shrink: 0;
}
.tag-count { font-size: 22rpx; color: #8E8E93; flex-shrink: 0; }

/* 一周打卡 */
.week { display: flex; justify-content: space-between; }
.wday {
  width: 78rpx; height: 100rpx; border-radius: 20rpx; background: #F2F2F7;
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx;
  border: 2rpx solid transparent;
}
.wday.on { background: #EAF6EC; border-color: rgba(52, 199, 89, 0.35); }
.wemoji { font-size: 30rpx; line-height: 1; }
.wlabel { font-size: 20rpx; color: #C7C7CC; }
.wday.on .wlabel { color: #34C759; }

/* 贴士 */
.tip { display: flex; align-items: flex-start; margin-bottom: 18rpx; }
.tip:last-child { margin-bottom: 0; }
.tip-dot { color: #34C759; font-weight: 700; margin-right: 14rpx; line-height: 1.6; }
.tip-text { flex: 1; font-size: 24rpx; color: #1C1C1E; line-height: 1.6; }

/* 分享卡 */
.share-canvas {
  width: 100%; height: 1540rpx; border-radius: 24rpx; background: #fff;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.06);
}
.btn-save {
  margin-top: 24rpx; width: 100%; background: #34C759; color: #fff;
  font-size: 30rpx; font-weight: 500; border-radius: 26rpx; border: none; line-height: 2.6;
}
.btn-save::after { border: none; }
.btn-hv { opacity: 0.85; }

/* 生成分享卡（按需触发） */
.btn-gen {
  width: 100%; background: #34C759; color: #fff; font-size: 30rpx; font-weight: 500;
  border-radius: 26rpx; border: none; line-height: 2.7;
  display: flex; align-items: center; justify-content: center; gap: 12rpx;
}
.btn-gen::after { border: none; }
.btn-gen-ico { font-size: 30rpx; }
.gen-loading { display: flex; flex-direction: column; align-items: center; padding: 44rpx 0; }
.spinner {
  width: 48rpx; height: 48rpx; border-radius: 50%;
  border: 4rpx solid rgba(52, 199, 89, 0.22); border-top-color: #34C759;
  animation: spin 0.8s linear infinite;
}
.gen-loading-text { margin-top: 18rpx; font-size: 24rpx; color: #8E8E93; }
@keyframes spin { to { transform: rotate(360deg); } }
.share-fade { animation: fadeUp 0.42s ease both; }
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(18rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.safe-bottom { height: env(safe-area-inset-bottom); }
