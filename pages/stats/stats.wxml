<view class="page">
  <view class="seg">
    <view class="seg-item {{period === 'week' ? 'on' : ''}}" data-p="week" bindtap="switchPeriod">本周</view>
    <view class="seg-item {{period === 'month' ? 'on' : ''}}" data-p="month" bindtap="switchPeriod">本月</view>
  </view>

  <view class="metrics">
    <view class="metric">
      <text class="m-label">记录次数</text>
      <text class="m-num">{{total}}</text>
    </view>
    <view class="metric">
      <text class="m-label">日均次数</text>
      <text class="m-num">{{avgPerDay}}</text>
    </view>
    <view class="metric">
      <text class="m-label">平均时长</text>
      <text class="m-num small">{{avgDur}}</text>
    </view>
    <view class="metric">
      <text class="m-label">理想型占比</text>
      <text class="m-num small">{{idealPct}}</text>
    </view>
  </view>

  <view class="card">
    <view class="card-head">
      <text class="card-title">每日次数</text>
      <text class="card-link" bindtap="goHistory">明细 ›</text>
    </view>
    <text class="card-hint">轻点折线可查看某一天的次数（默认高亮今天）</text>
    <canvas type="2d" id="trendCanvas" class="trend-canvas" bindtouchstart="onTrendTouch"></canvas>
  </view>

  <view class="card">
    <text class="card-title">Bristol 类型分布</text>
    <view class="ring-wrap">
      <canvas type="2d" id="ringCanvas" class="ring-canvas"></canvas>
      <view class="ring-legend">
        <view class="legend-item" wx:for="{{dist}}" wx:key="type">
          <view class="legend-dot" style="background:{{item.color}};"></view>
          <text class="legend-name">{{item.name}}</text>
          <text class="legend-pct">{{item.pct}}%</text>
        </view>
      </view>
    </view>
  </view>

  <view class="card">
    <text class="card-title">高频症状</text>
    <view class="sym-row" wx:if="{{symptoms.length}}">
      <view class="sym-chip" wx:for="{{symptoms}}" wx:key="name">{{item.name}} ×{{item.count}}</view>
    </view>
    <view class="empty" wx:else>本周期暂无症状记录</view>
  </view>
</view>
