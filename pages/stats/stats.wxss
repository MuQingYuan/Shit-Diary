.page {
  min-height: 100vh;
  background: #F2F2F7;
  padding: 24rpx 32rpx 40rpx;
  box-sizing: border-box;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
  color: #1C1C1E;
}

.seg {
  display: flex;
  background: #E9E9EE;
  border-radius: 20rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}
.seg-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #8E8E93;
  transition: all 0.2s;
}
.seg-item.on {
  background: #fff;
  color: #1C1C1E;
  font-weight: 600;
}

.metrics {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 24rpx;
}
.metric {
  width: calc(50% - 10rpx);
  background: #fff;
  border-radius: 28rpx;
  padding: 28rpx;
  box-sizing: border-box;
}
.m-label { display: block; font-size: 24rpx; color: #8E8E93; }
.m-num { display: block; margin-top: 10rpx; font-size: 52rpx; font-weight: 600; color: #34C759; }
.m-num.small { font-size: 36rpx; }

.card {
  background: #fff;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.card-title { font-size: 30rpx; font-weight: 600; }
.card-link { font-size: 24rpx; color: #34C759; }

.bars {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 4rpx;
}
.bar-item { display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.bar-count { font-size: 20rpx; color: #34C759; font-weight: 500; }
.bar { width: 36rpx; border-radius: 8rpx; background: #C8E6CB; }
.bar.hot { background: #34C759; }
.bar-day { font-size: 20rpx; color: #8E8E93; }

.dist-item {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}
.dist-name { width: 180rpx; font-size: 24rpx; color: #555; }
.dist-track {
  flex: 1;
  height: 16rpx;
  background: #F0F0F3;
  border-radius: 8rpx;
  margin: 0 16rpx;
  overflow: hidden;
}
.dist-fill { height: 100%; background: #34C759; border-radius: 8rpx; min-width: 4rpx; }
.dist-pct { width: 80rpx; text-align: right; font-size: 22rpx; color: #8E8E93; }

.sym-row { display: flex; flex-wrap: wrap; gap: 16rpx; }
.sym-chip {
  background: #EAF6EC;
  color: #2E9E4F;
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  border-radius: 28rpx;
}
.empty { font-size: 24rpx; color: #8E8E93; text-align: center; padding: 32rpx 0; }
