.page {
  min-height: 100vh;
  background: #F2F2F7;
  padding: 24rpx 32rpx 40rpx;
  box-sizing: border-box;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
  color: #1C1C1E;
}

.seg {
  display: flex;
  background: #E9E9EE;
  border-radius: 20rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}
.seg-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #8E8E93;
  transition: all 0.2s;
}
.seg-item.on {
  background: #fff;
  color: #1C1C1E;
  font-weight: 600;
}

.metrics {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 24rpx;
}
.metric {
  width: calc(50% - 10rpx);
  background: #fff;
  border-radius: 28rpx;
  padding: 28rpx;
  box-sizing: border-box;
}
.m-label { display: block; font-size: 24rpx; color: #8E8E93; }
.m-num { display: block; margin-top: 10rpx; font-size: 52rpx; font-weight: 600; color: #34C759; }
.m-num.small { font-size: 36rpx; }

.card {
  background: #fff;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.card-title { font-size: 30rpx; font-weight: 600; }
.card-link { font-size: 24rpx; color: #34C759; }

.trend-canvas {
  width: 100%;
  height: 260rpx;
  display: block;
  touch-action: none;
}
.card-hint {
  display: block;
  font-size: 22rpx;
  color: #8E8E93;
  margin-bottom: 12rpx;
}

.ring-wrap {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}
.ring-canvas {
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
}
.ring-legend {
  flex: 1;
  margin-left: 24rpx;
}
.legend-item {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}
.legend-item:last-child { margin-bottom: 0; }
.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 12rpx;
}
.legend-name {
  flex: 1;
  font-size: 22rpx;
  color: #555;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.legend-pct { width: 70rpx; text-align: right; font-size: 22rpx; color: #8E8E93; }

.sym-row { display: flex; flex-wrap: wrap; gap: 16rpx; }
.sym-chip {
  background: #EAF6EC;
  color: #2E9E4F;
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  border-radius: 28rpx;
}
.empty { font-size: 24rpx; color: #8E8E93; text-align: center; padding: 32rpx 0; }
