.page {
  min-height: 100vh;
  background: #F2F2F7;
  padding: 24rpx 32rpx 40rpx;
  box-sizing: border-box;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
  color: #1C1C1E;
}

.hv { opacity: 0.6; }

.card {
  background: #fff;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.report {
  background: linear-gradient(135deg, #34C759, #2E9E4F);
  display: flex;
  flex-direction: column;
  align-items: center;
}
.report-icon { font-size: 72rpx; }
.report-title { color: #fff; font-size: 36rpx; font-weight: 600; margin-top: 12rpx; }
.report-sub { color: rgba(255, 255, 255, 0.85); font-size: 24rpx; margin-top: 8rpx; }
.btn-share {
  margin-top: 28rpx;
  background: #fff;
  color: #2E9E4F;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 24rpx;
  width: 80%;
  border: none;
}
.btn-share::after { border: none; }

.card-tap { position: relative; }
.card-title { display: block; font-size: 30rpx; font-weight: 600; }
.card-sub { display: block; font-size: 24rpx; color: #8E8E93; margin-top: 10rpx; }
.arrow {
  position: absolute;
  right: 28rpx;
  top: 50%;
  transform: translateY(-50%);
  color: #C7C7CC;
  font-size: 36rpx;
}

.cta { background: #EAF6EC; text-align: center; }
.cta-text { font-size: 26rpx; color: #2E9E4F; font-weight: 500; }
