.page {
  min-height: 100vh;
  background: #F2F2F7;
  padding: 24rpx 32rpx 40rpx;
  box-sizing: border-box;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
  color: #1C1C1E;
}

.hv { opacity: 0.6; }

.card {
  background: #fff;
  border-radius: 28rpx;
  padding: 12rpx 28rpx;
  margin-bottom: 24rpx;
}
.cell {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 0.5px solid rgba(60, 60, 67, 0.08);
}
.cell:last-child { border-bottom: none; }
.cell-label { font-size: 30rpx; }
.cell-value { font-size: 30rpx; color: #34C759; font-weight: 500; }

.card-title { font-size: 30rpx; font-weight: 600; padding: 24rpx 0 20rpx; }
.days { display: flex; gap: 14rpx; padding-bottom: 24rpx; }
.day-chip {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: #F0F0F3;
  color: #8E8E93;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}
.day-chip.on { background: #34C759; color: #fff; font-weight: 600; }

.desc {
  display: block;
  font-size: 24rpx;
  color: #8E8E93;
  line-height: 1.6;
  padding: 8rpx 0 20rpx;
}
.btn-sub {
  background: #EAF6EC;
  color: #2E9E4F;
  font-size: 28rpx;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  border: none;
}
.btn-sub::after { border: none; }

.btn-save {
  background: #34C759;
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 26rpx;
  border: none;
  line-height: 2.6;
}
.btn-save::after { border: none; }
